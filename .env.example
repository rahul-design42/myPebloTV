# ============================================================
# Peblo TV Mini — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ------ Database ------
# For local development: postgresql://peblo:peblo@localhost:5432/peblodb
# For Docker Compose:    postgresql://peblo:peblo@db:5432/peblodb
DATABASE_URL=postgresql://peblo:peblo@localhost:5432/peblodb

# ------ JWT ------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the default in production.
SECRET_KEY=dev-secret-key-change-in-production-use-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------ Storage ------
# Local disk path where uploaded artwork and catalogues are stored.
# In production this switches to Cloudflare R2 (change the StorageBackend class).
STORAGE_ROOT=./storage
# Base URL from which stored files are served (must match reverse-proxy config).
STORAGE_BASE_URL=http://localhost:8000/media

# ------ Seed / Reference paths ------
# These point to the seed data files. Defaults work inside the Docker container.
REFERENCE_JSON_PATH=/seed/reference.json
SEED_DATA_PATH=/seed/seed_shows.json
SEED_ASSETS_DIR=/seed/assets

# ------ Test database (optional) ------
# If set, pytest uses this URL instead of deriving from DATABASE_URL.
# TEST_DATABASE_URL=postgresql://peblo:peblo@localhost:5432/peblodb_test

# ------ Production secrets management note ------
# In production, inject secrets via your platform's secret manager
# (e.g. AWS Secrets Manager, GCP Secret Manager, Doppler) rather than
# storing them in .env files.  Never commit .env to version control.
